# No PDF is ever committed to this repository, under any licence.
# Audit rule S03 checks that `git ls-files pdf/` is empty, because the difference between a corpus and a mirror is this line and one careless `git add -f`.
pdf/

# Page rasters. Large, derived, and regenerated by `papers render`.
images/

# Queues, caches and scratch space for the toolchain.
work/

# Set books. papers book writes LaTeX, a PDF and an EPUB, and the PDF and the
# EPUB are the paper itself in one file. Audit rule S03 fails on either of
# them in the index.
books/

.DS_Store
